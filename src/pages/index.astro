    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>Rokk Lab</title>
  </head>

  <body class="bg-white font-sans text-black">
    <Hero />
    <About />
    <FeaturedLooks />
    <BookingCta />
    <Footer />

    <script>
      import { initAnimations } from "../scripts/animations";

      initAnimations();
    </script>
  </body>
</html>
