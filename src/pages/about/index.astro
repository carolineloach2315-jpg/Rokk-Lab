---
import "../../styles/global.css";
import Header from "../../components/global/header.astro";
import Footer from "../../components/global/footer.astro";
import Button from "../../components/landing/button.astro";
import salonColourImage from "../../assets/about/images/salon-colour.png";
import salonColourTwoImage from "../../assets/about/images/salon-colour-2.png";
import salonColourThreeImage from "../../assets/about/images/salon-colour-3.png";

const bookingUrl =
  "https://booking.clientdiary.com/?bookingsUrl=RokkLab&utm_source=ig&utm_medium=social&utm_content=link_in_bio&fbclid=PAZXh0bgNhZW0CMTEAc3J0YwZhcHBfaWQPOTM2NjE5NzQzMzkyNDU5AAGn9FErYtiyf2PHYkbbmUEiDdfX4kKj7467IwK1oOtJ28Sg-mF-_6AGlJuuR6c_aem_wew15SLhLb1jQXxDGi8fpg";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>About Rokk Lab | Rokk Lab</title>
  </head>

  <body class="bg-[#191919] font-sans text-white">
    <main>
      <section
        class="relative min-h-screen overflow-hidden bg-neutral-200 text-black"
        data-hero-scroll-section
      >
        <Header />

        <div class="pointer-events-none absolute inset-0">
          <img
            src={salonColourImage.src}
            alt="Rokk Lab salon interior with styling chairs and product shelves"
            class="h-full w-full object-cover object-center"
            data-hero-scroll-image
          />
          <div
            class="absolute inset-0 bg-gradient-to-r from-neutral-100 via-neutral-100/95 via-[52%] to-neutral-100/70 md:via-neutral-100/88 md:via-[37%] md:to-transparent"
          >
          </div>
          <div
            class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-neutral-100/95 via-neutral-100/35 to-transparent"
          >
          </div>
        </div>

        <div
          class="relative z-10 mx-auto flex min-h-screen max-w-7xl items-center px-6 pb-16 pt-44 md:px-16 md:pb-20 md:pt-36"
        >
          <div class="max-w-[42rem]">
            <p
              class="mb-6 text-xs font-bold uppercase tracking-[0.35em] text-orange-600"
            >
              About Us
            </p>

            <h1
              class="max-w-3xl text-5xl font-black uppercase leading-[0.95] tracking-normal text-black sm:text-6xl md:text-7xl lg:text-[5.6rem]"
            >
              Experts in beauty and precision.
            </h1>

            <p
              class="mt-7 max-w-lg text-base font-semibold leading-8 text-neutral-700 md:text-lg md:leading-9"
            >
              At Rokk Lab, we blend creativity with technique to create hair
              that looks effortless, modern, and tailored to you.
            </p>

            <div class="mt-9 flex">
              <Button href={bookingUrl}>Book Your Appointment</Button>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-[#191919] px-6 py-16 text-white md:px-16 md:py-20">
        <div
          class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[1.03fr_0.97fr] lg:items-start lg:gap-16"
        >
          <div class="overflow-hidden border border-black/70 bg-neutral-900">
            <img
              src={salonColourTwoImage.src}
              alt="Rokk Lab salon product display with greenery"
              class="aspect-[1672/941] h-full w-full object-cover"
              loading="lazy"
            />
          </div>

          <div class="max-w-2xl lg:pt-6">
            <p
              class="mb-5 text-xs font-bold uppercase tracking-[0.35em] text-orange-500"
            >
              Our Story
            </p>

            <h2
              class="text-4xl font-black uppercase leading-tight text-white drop-shadow-[0_2px_1px_rgba(0,0,0,0.65)] sm:text-5xl md:text-[3.25rem]"
            >
              Passion. Precision. Personalised for you.
            </h2>

            <div
              class="mt-8 space-y-6 text-base font-semibold leading-8 text-neutral-200 md:text-lg md:leading-9"
            >
              <p>
                Rokk Lab was founded with a simple vision — to create a space
                where science meets style.
              </p>

              <p>
                We believe great hair starts with healthy foundations, expert
                advice, and a personalised approach. Our salon is designed to be
                a modern, welcoming space where you can relax, feel confident,
                and leave with hair you love.
              </p>

              <p>
                From precision cuts to lived-in colour and nourishing
                treatments, every service is delivered with care, creativity,
                and attention to detail.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-neutral-100 px-6 py-16 text-black md:px-16 md:py-20">
        <div class="mx-auto max-w-7xl">
          <div class="mb-12 text-center">
            <p
              class="mb-5 text-xs font-bold uppercase tracking-[0.35em] text-orange-600"
            >
              Our Values
            </p>

            <h2
              class="text-3xl font-black uppercase leading-tight sm:text-4xl md:text-5xl"
            >
              What sets us apart
            </h2>
          </div>

          <div class="grid gap-0 md:grid-cols-4" data-stagger-parent>
            <article
              class="border-b border-neutral-300 px-6 py-8 text-center md:border-b-0 md:px-10"
              data-stagger-card
            >
              <div class="mx-auto mb-7 flex h-16 w-16 items-center justify-center text-black">
                <svg data-draw-icon xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scissors-icon lucide-scissors h-14 w-14" aria-hidden="true"><circle cx="6" cy="6" r="3" /><path d="M8.12 8.12 12 12" /><path d="M20 4 8.12 15.88" /><circle cx="6" cy="18" r="3" /><path d="M14.8 14.8 20 20" /></svg>
              </div>

              <h3 class="text-base font-black uppercase tracking-wide">
                Precision
              </h3>

              <p class="mx-auto mt-5 max-w-[13rem] text-base font-medium leading-7 text-neutral-700">
                Precision cuts and techniques tailored to your style.
              </p>
            </article>

            <article
              class="border-b border-neutral-300 px-6 py-8 text-center md:border-b-0 md:border-l md:px-10"
              data-stagger-card
            >
              <div class="mx-auto mb-7 flex h-16 w-16 items-center justify-center text-black">
                <svg data-draw-icon xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-paintbrush-vertical-icon lucide-paintbrush-vertical h-14 w-14" aria-hidden="true"><path d="M10 2v2" /><path d="M14 2v4" /><path d="M17 2a1 1 0 0 1 1 1v9H6V3a1 1 0 0 1 1-1z" /><path d="M6 12a1 1 0 0 0-1 1v1a2 2 0 0 0 2 2h2a1 1 0 0 1 1 1v2.9a2 2 0 1 0 4 0V17a1 1 0 0 1 1-1h2a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1" /></svg>
              </div>

              <h3 class="text-base font-black uppercase tracking-wide">
                Expert colour
              </h3>

              <p class="mx-auto mt-5 max-w-[13rem] text-base font-medium leading-7 text-neutral-700">
                Modern colour techniques for beautiful, lasting results.
              </p>
            </article>

            <article
              class="border-b border-neutral-300 px-6 py-8 text-center md:border-b-0 md:border-l md:px-10"
              data-stagger-card
            >
              <div class="mx-auto mb-7 flex h-16 w-16 items-center justify-center text-black">
                <svg data-draw-icon xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart-icon lucide-heart h-14 w-14" aria-hidden="true"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5" /></svg>
              </div>

              <h3 class="text-base font-black uppercase tracking-wide">
                Quality care
              </h3>

              <p class="mx-auto mt-5 max-w-[13rem] text-base font-medium leading-7 text-neutral-700">
                We use high-performance products that nourish and protect your
                hair.
              </p>
            </article>

            <article
              class="px-6 py-8 text-center md:border-l md:border-neutral-300 md:px-10"
              data-stagger-card
            >
              <div class="mx-auto mb-7 flex h-16 w-16 items-center justify-center text-black">
                <svg data-draw-icon xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-flame-icon lucide-flame h-14 w-14" aria-hidden="true"><path d="M12 3q1 4 4 6.5t3 5.5a1 1 0 0 1-14 0 5 5 0 0 1 1-3 1 1 0 0 0 5 0c0-2-1.5-3-1.5-5q0-2 2.5-4" /></svg>
              </div>

              <h3 class="text-base font-black uppercase tracking-wide">
                Personalised
              </h3>

              <p class="mx-auto mt-5 max-w-[13rem] text-base font-medium leading-7 text-neutral-700">
                Every appointment is personalised to suit your hair and
                lifestyle.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="bg-neutral-100 px-6 py-16 text-black md:px-16 md:py-24">
        <div
          class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:items-start"
        >
          <div class="max-w-md">
            <p
              class="mb-5 text-xs font-bold uppercase tracking-[0.35em] text-orange-600"
            >
              Meet the founders
            </p>

            <h2
              class="text-4xl font-black uppercase leading-tight sm:text-5xl md:text-6xl"
            >
              Experienced. Creative. Dedicated.
            </h2>

            <p class="mt-8 text-base font-medium leading-8 text-neutral-700">
              Rokk Lab is led by founders who bring precision, creativity, and
              care to every part of the salon experience.
            </p>

            <div class="mt-10">
              <a
                href="/contact"
                class="inline-flex items-center justify-center border border-black px-8 py-4 text-xs font-bold uppercase tracking-wide text-black transition hover:border-orange-600 hover:bg-orange-600 hover:text-white"
              >
                Contact Us
              </a>
            </div>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <article class="bg-white shadow-[0_18px_45px_rgba(0,0,0,0.06)]">
              <div
                class="flex aspect-[4/5] items-center justify-center bg-neutral-200"
              >
                <span
                  class="text-xs font-bold uppercase tracking-[0.28em] text-neutral-500"
                >
                  Image Placeholder
                </span>
              </div>

              <div class="px-7 py-7">
                <h3 class="text-xl font-black uppercase tracking-wide">
                  Brad
                </h3>
              </div>
            </article>

            <article class="bg-white shadow-[0_18px_45px_rgba(0,0,0,0.06)]">
              <div
                class="flex aspect-[4/5] items-center justify-center bg-neutral-200"
              >
                <span
                  class="text-xs font-bold uppercase tracking-[0.28em] text-neutral-500"
                >
                  Image Placeholder
                </span>
              </div>

              <div class="px-7 py-7">
                <h3 class="text-xl font-black uppercase tracking-wide">
                  Ivan
                </h3>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="overflow-hidden bg-[#191919] px-6 py-16 text-white md:px-16 md:py-24">
        <div
          class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[1.95fr_0.75fr] lg:items-center lg:gap-16"
        >
          <div class="grid gap-3 sm:grid-cols-3">
            <div class="overflow-hidden border border-black bg-neutral-900">
              <img
                src={salonColourTwoImage.src}
                alt="Rokk Lab product display and greenery"
                class="aspect-[0.95/1] h-full w-full object-cover"
                loading="lazy"
              />
            </div>

            <div class="overflow-hidden border border-black bg-neutral-900">
              <img
                src={salonColourThreeImage.src}
                alt="Rokk Lab wash basins and salon shelves"
                class="aspect-[0.95/1] h-full w-full object-cover"
                loading="lazy"
              />
            </div>

            <div class="overflow-hidden border border-black bg-neutral-900">
              <img
                src={salonColourImage.src}
                alt="Rokk Lab salon corridor with illuminated mirrors"
                class="aspect-[0.95/1] h-full w-full object-cover"
                loading="lazy"
              />
            </div>
          </div>

          <div class="lg:max-w-md">
            <p
              class="mb-6 text-xs font-bold uppercase tracking-[0.35em] text-orange-500"
            >
              Our Space
            </p>

            <h2
              class="text-4xl font-black uppercase leading-tight text-white drop-shadow-[0_2px_1px_rgba(0,0,0,0.65)] sm:text-5xl md:text-[3.35rem]"
            >
              Designed for you to relax
            </h2>

            <p class="mt-7 max-w-md text-base font-semibold leading-8 text-neutral-300 md:text-lg md:leading-8">
              Our salon is a space where you can unwind and enjoy a premium
              hair experience in a modern, calming environment.
            </p>

            <a
              href="/contact"
              class="mt-9 inline-flex items-center justify-center border border-white/70 px-8 py-4 text-xs font-bold uppercase tracking-wide text-white transition hover:border-orange-600 hover:bg-orange-600"
            >
              Visit the salon
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      import { initAnimations } from "../../scripts/animations";

      initAnimations();
    </script>
  </body>
</html>
