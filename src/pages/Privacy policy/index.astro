---
import "../../styles/global.css";
import Header from "../../components/landing/header.astro";
import Footer from "../../components/footer.astro";

const sections = [
  {
    title: "Information We Collect",
    groups: [
      {
        heading: "Personal Details",
        items: ["Name", "Email address", "Phone number", "Address (where required)"],
      },
      {
        heading: "Appointment Information",
        items: [
          "Appointment history",
          "Service preferences",
          "Consultation notes",
          "Hair treatment records where relevant",
        ],
      },
      {
        heading: "Payment Information",
        items: [
          "Payment details processed securely through third-party payment providers",
          "Transaction history",
        ],
      },
      {
        heading: "Website Information",
        items: [
          "IP address",
          "Browser type",
          "Device information",
          "Website usage data through cookies and analytics tools",
        ],
      },
    ],
  },
  {
    title: "How We Use Your Information",
    items: [
      "Manage and confirm appointments",
      "Provide salon services",
      "Process payments",
      "Respond to enquiries",
      "Send appointment reminders",
      "Improve our website and services",
      "Send promotional offers and marketing communications (you may opt out at any time)",
      "Comply with legal obligations",
    ],
  },
  {
    title: "Marketing Communications",
    body: "With your consent, we may send emails, SMS messages, or promotional offers regarding:",
    items: ["New services", "Special promotions", "Product launches", "Salon updates"],
    closing: "You may unsubscribe from marketing communications at any time.",
  },
  {
    title: "Sharing Your Information",
    body: "We do not sell your personal information. We may share information with trusted third-party providers who assist us with:",
    items: [
      "Appointment booking systems",
      "Payment processing",
      "Website hosting",
      "Marketing platforms",
      "Analytics services",
    ],
    closing: "These providers are only permitted to use your information as necessary to provide services to us.",
  },
  {
    title: "Cookies",
    body: "Our website may use cookies and similar technologies to:",
    items: [
      "Improve website performance",
      "Understand visitor behaviour",
      "Remember user preferences",
      "Support marketing and analytics",
    ],
    closing: "You can control cookie settings through your browser.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>Privacy Policy | Rokk Lab</title>
  </head>

  <body class="bg-neutral-200 font-sans text-black">
    <main>
      <section class="relative bg-neutral-200 px-8 pb-20 pt-40 md:px-16 lg:pt-44">
        <Header />

        <div class="mx-auto max-w-4xl">
          <div class="mb-12 text-center">
            <p class="text-xs font-black uppercase tracking-[0.35em] text-orange-600">
              Rokk Lab
            </p>
            <div class="mx-auto mt-4 h-px w-28 bg-orange-600"></div>

            <h1 class="mt-7 text-4xl font-black uppercase leading-none text-black md:text-6xl">
              Privacy Policy
            </h1>

            <p class="mt-5 text-sm font-semibold text-neutral-600">
              Last Updated: 18 June 2026
            </p>
          </div>

          <article class="rounded-md border border-neutral-300/80 bg-white px-8 py-10 shadow-[0_20px_55px_rgba(0,0,0,0.08)] md:px-12 md:py-12">
            <div class="space-y-5 text-sm font-normal leading-7 text-neutral-700">
              <p>
                At Rokk Lab Hair Salon ("Rokk Lab", "we", "our", or "us"),
                we are committed to protecting your privacy and handling your
                personal information in accordance with applicable Australian
                privacy laws.
              </p>

              <p>
                This Privacy Policy explains how we collect, use, disclose and
                store your personal information when you:
              </p>

              <ul class="list-disc space-y-2 pl-5">
                <li>Visit our website;</li>
                <li>Book an appointment with us;</li>
                <li>Purchase products or services;</li>
                <li>Contact us by phone, email, social media, or online forms; or</li>
                <li>Otherwise interact with Rokk Lab Hair Salon.</li>
              </ul>

              <p>
                By using our website or services, you consent to the collection
                and use of your information as described in this Privacy Policy.
              </p>
            </div>

            <div class="mt-10 space-y-10">
              {sections.map((section) => (
                <section class="border-t border-neutral-200 pt-8">
                  <h2 class="mb-5 text-xl font-black uppercase tracking-wide text-black">
                    {section.title}
                  </h2>

                  {section.body && (
                    <p class="mb-5 text-sm font-normal leading-7 text-neutral-700">
                      {section.body}
                    </p>
                  )}

                  {section.groups ? (
                    <div class="grid gap-6 md:grid-cols-2">
                      {section.groups.map((group) => (
                        <div>
                          <h3 class="mb-3 text-xs font-black uppercase tracking-[0.18em] text-orange-600">
                            {group.heading}
                          </h3>
                          <ul class="list-disc space-y-2 pl-5 text-sm font-normal leading-7 text-neutral-700">
                            {group.items.map((item) => <li>{item}</li>)}
                          </ul>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <ul class="list-disc space-y-2 pl-5 text-sm font-normal leading-7 text-neutral-700">
                      {section.items.map((item) => <li>{item}</li>)}
                    </ul>
                  )}

                  {section.closing && (
                    <p class="mt-5 text-sm font-normal leading-7 text-neutral-700">
                      {section.closing}
                    </p>
                  )}
                </section>
              ))}

              <section class="border-t border-neutral-200 pt-8">
                <h2 class="mb-5 text-xl font-black uppercase tracking-wide text-black">
                  Security
                </h2>
                <div class="space-y-5 text-sm font-normal leading-7 text-neutral-700">
                  <p>
                    We take reasonable steps to protect your personal information
                    from misuse, interference, loss, unauthorised access,
                    modification, or disclosure.
                  </p>
                  <p>
                    However, no online transmission or storage system can be
                    guaranteed to be completely secure.
                  </p>
                </div>
              </section>

              <section class="border-t border-neutral-200 pt-8">
                <h2 class="mb-5 text-xl font-black uppercase tracking-wide text-black">
                  Access and Correction
                </h2>
                <p class="text-sm font-normal leading-7 text-neutral-700">
                  You may request access to, or correction of, your personal
                  information at any time by contacting us.
                </p>
              </section>

              <section class="border-t border-neutral-200 pt-8">
                <h2 class="mb-5 text-xl font-black uppercase tracking-wide text-black">
                  Contact Us
                </h2>
                <p class="mb-5 text-sm font-normal leading-7 text-neutral-700">
                  If you have questions about this Privacy Policy or how we
                  handle your personal information, please contact:
                </p>
                <div class="space-y-2 text-sm font-normal leading-7 text-neutral-700">
                  <p class="font-semibold text-black">Rokk Lab Hair Salon</p>
                  <p>Email: hello@rokklab.com.au</p>
                  <p>Phone: (08) 611 358 47</p>
                  <p>Address: 908 Canning Hwy Applecross 6153</p>
                </div>
              </section>
            </div>
          </article>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
