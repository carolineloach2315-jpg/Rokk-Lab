---
const tradingHours = [
  "Sunday - Monday: Closed",
  "Tuesday: 9am-8pm",
  "Wednesday: 10am-5pm",
  "Thursday: 9am-8pm",
  "Friday: 10am-5pm",
  "Saturday: 8am-5pm",
];
---

<footer class="bg-black px-6 py-16 text-white md:px-16 md:py-20">
  <div class="mx-auto grid max-w-7xl gap-12 md:grid-cols-2 md:gap-16">
    <section>
      <h2 class="mb-7 text-xl font-semibold uppercase tracking-wide">
        Trading Hours
      </h2>

      <ul class="space-y-4 text-sm font-normal leading-6 text-neutral-300 md:space-y-5 md:text-base md:leading-tight">
        {tradingHours.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section>
      <h2 class="mb-7 text-xl font-semibold uppercase tracking-wide">
        Contact
      </h2>

      <div class="space-y-4 text-sm font-normal leading-6 text-neutral-300 md:space-y-5 md:text-base md:leading-tight">
        <p>Rokk Lab</p>
        <p>908 Canning Hwy Applecross 6153</p>
        <p>
          <a href="tel:+61861135847" class="transition hover:text-orange-500">
            (08) 611 358 47
          </a>
        </p>
        <p>
          <a
            href="mailto:hello@rokklab.com.au"
            class="transition hover:text-orange-500"
          >
            hello@rokklab.com.au
          </a>
        </p>
      </div>

      <div class="mt-12 flex gap-4">
        <a
          href="https://www.facebook.com/rokklab/"
          aria-label="Rokk Lab on Facebook"
          class="flex h-14 w-14 items-center justify-center rounded bg-orange-500 text-white transition hover:bg-white hover:text-black"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            aria-hidden="true"
            class="h-7 w-7"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M14.2 8.1V6.7c0-.7.5-.9 1-.9h1.8V2.7L14.5 2.6c-2.8 0-4.3 1.7-4.3 4.7v.8H7.4v3.5h2.8V21h3.6v-9.4h2.8l.5-3.5h-3Z"
            ></path>
          </svg>
        </a>

        <a
          href="https://www.instagram.com/rokk_lab/"
          aria-label="Rokk Lab on Instagram"
          class="flex h-14 w-14 items-center justify-center rounded bg-orange-500 text-white transition hover:bg-white hover:text-black"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            aria-hidden="true"
            class="h-7 w-7"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"
            ></circle>
          </svg>
        </a>
      </div>
    </section>
  </div>

  <div class="mx-auto mt-12 flex max-w-7xl border-t border-white/10 pt-8 md:mt-16">
    <a
      href="/Privacy%20policy/"
      class="text-xs font-normal uppercase tracking-wide text-neutral-400 transition hover:text-orange-500"
    >
      Privacy Policy
    </a>
  </div>
</footer>
