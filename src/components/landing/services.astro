---
import colourIcon from "../../assets/icons/colour.png";
import cutIcon from "../../assets/icons/cut.png";
import styleIcon from "../../assets/icons/style.png";
import treatmentIcon from "../../assets/icons/treatment.png";

const services = [
  {
    title: "Cut",
    description: "Precision cuts tailored to your style.",
    image: cutIcon,
  },
  {
    title: "Color",
    description: "Modern color techniques that enhance you.",
    image: colourIcon,
  },
  {
    title: "Styling",
    description: "Blowouts, waves, and finishing touches.",
    image: styleIcon,
  },
  {
    title: "Treatments",
    description: "Nourishing treatments for healthy hair.",
    image: treatmentIcon,
  },
];
---

<section id="services" class="bg-black px-8 py-24 text-white md:px-16">
  <div class="mx-auto max-w-7xl">
    <p class="mb-12 text-center text-sm font-black uppercase tracking-[0.18em] text-orange-600">
      Our services
    </p>

    <div class="grid gap-y-12 md:grid-cols-4 md:gap-y-0">
      {
        services.map((service, index) => (
          <article
            class={`flex flex-col items-center px-8 text-center ${
              index === 0 ? "" : "md:border-l md:border-white/20"
            }`}
          >
            <img
              src={service.image.src}
              alt=""
              class="mb-7 h-16 w-16 object-contain brightness-0 invert"
            />

            <h3 class="mb-5 text-xl font-black uppercase tracking-wide">
              {service.title}
            </h3>

            <p class="max-w-[11rem] text-base font-semibold leading-7 text-neutral-300">
              {service.description}
            </p>
          </article>
        ))
      }
    </div>

    <a
      href="#services"
      class="mx-auto mt-16 flex w-fit items-center gap-8 text-sm font-black uppercase tracking-[0.12em] text-orange-600 transition hover:text-white"
    >
      View all services
      <span class="text-3xl leading-none">→</span>
    </a>
  </div>
</section>
