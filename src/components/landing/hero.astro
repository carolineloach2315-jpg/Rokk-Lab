---
import Header from "./header.astro";
import Button from "./button.astro";
import heroCopperHair from "../../assets/home/hero-copper-hair.png";
---

<section class="relative min-h-screen overflow-hidden bg-neutral-200">
  <Header />

  <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-full items-start justify-end pt-0 md:right-20 md:flex md:w-[74%]">
    <div class="relative h-[calc(100%+3rem)] w-full -translate-y-12">
      <img
        src={heroCopperHair.src}
        alt="Copper salon waves from behind"
        class="h-full w-full object-cover object-center"
        style="-webkit-mask-image: linear-gradient(to right, transparent 0%, black 46%, black 84%, transparent 100%); mask-image: linear-gradient(to right, transparent 0%, black 46%, black 84%, transparent 100%); -webkit-mask-size: 100% 100%; mask-size: 100% 100%; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;"
      />
      <div class="absolute inset-y-0 left-0 w-1/2 bg-gradient-to-r from-neutral-200 via-neutral-200/90 via-45% to-transparent"></div>
      <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-neutral-200 via-neutral-200/30 to-transparent"></div>
    </div>
  </div>

  <div class="relative z-10 mx-auto grid min-h-screen max-w-7xl items-center px-6 pb-16 pt-44 md:grid-cols-2 md:px-16 md:pb-0 md:pt-30 md:items-start">
    <div class="relative z-10 max-w-xl md:mt-8">
      <p class="mb-6 text-xs font-bold uppercase tracking-[0.35em] text-orange-600">
        Where style meets science
      </p>

      <h1 class="mb-6 text-5xl font-black uppercase leading-[0.95] tracking-normal text-black sm:text-6xl md:text-7xl lg:text-8xl">
        Cut. Colour. Confidence.
      </h1>

      <p class="mb-8 max-w-md text-sm leading-7 text-neutral-700 sm:text-base">
        Rokk Lab is a modern hair salon dedicated to precision cuts,
        lived-in color, and effortless style.
      </p>

      <Button href="https://booking.clientdiary.com/?bookingsUrl=RokkLab&utm_source=ig&utm_medium=social&utm_content=link_in_bio&fbclid=PAZXh0bgNhZW0CMTEAc3J0YwZhcHBfaWQPOTM2NjE5NzQzMzkyNDU5AAGn9FErYtiyf2PHYkbbmUEiDdfX4kKj7467IwK1oOtJ28Sg-mF-_6AGlJuuR6c_aem_wew15SLhLb1jQXxDGi8fpg">Book Your Appointment</Button>
    </div>
  </div>
</section>
