---
import Button from "./button.astro";
const navItems = ["Home", "Services", "About", "Contact"];
---

<header class="absolute left-0 top-0 z-20 w-full px-8 py-8 md:px-16">
  <div class="mx-auto flex max-w-7xl items-center justify-between">
  <a href="/" aria-label="ROKK LAB home">
  <img
    src="/images/rokk-lab-logo.png"
    alt="ROKK LAB"
    class="h-16 w-auto"
  />
</a> 

    <nav class="hidden items-center gap-10 md:flex">
      {navItems.map((item) => (
        <a
          href={`#${item.toLowerCase()}`}
          class={`text-xs font-bold uppercase tracking-wide transition hover:text-orange-600 ${
            item === "Home" ? "text-orange-600" : "text-black"
          }`}
        >
          {item}
        </a>
      ))}
    </nav>

    <div class="hidden md:block">
      <Button href="#booking" variant="outline">Book Now</Button>
    </div>
  </div>
</header>
