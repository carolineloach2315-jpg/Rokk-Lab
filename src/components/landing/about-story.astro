---
import Button from "../../components/landing/button.astro";
import salonImage from "../../assets/home/salon.png";
---

<section id="about-story" class="overflow-hidden bg-[#161616] text-white">
  <div
    class="mx-auto grid max-w-7xl gap-10 px-6 py-14 md:px-16 md:py-16 lg:grid-cols-[0.9fr_1.25fr] lg:items-stretch lg:gap-12 lg:py-0"
  >
    <div class="flex max-w-xl flex-col justify-center lg:py-20">
      <p class="mb-5 text-xs font-bold uppercase tracking-[0.35em] text-orange-600">
        About Rokk Lab
      </p>

      <h2
        class="text-4xl font-black uppercase leading-[0.98] text-white sm:text-5xl lg:text-[3.35rem]"
      >
        Science. Style. Self expression.
      </h2>

      <div class="mt-7 space-y-5 text-base font-semibold leading-7 text-neutral-300">
        <p>
          We believe great hair is both an art and a science. Our stylists
          combine advanced technique with creative vision to deliver results
          that feel effortlessly you.
        </p>

        <p>
          From precision cutting to custom colour transformations, every detail
          is thoughtfully designed to enhance your natural beauty and lifestyle.
        </p>
      </div>

      <div class="mt-9">
        <Button href="/about/" variant="outline-light">Our Story</Button>
      </div>
    </div>

    <div class="-mx-6 md:-mx-16 lg:mx-0 lg:min-h-[28rem]">
      <img
        src={salonImage.src}
        alt="Rokk Lab salon interior"
        class="h-full max-h-[28rem] w-full object-cover object-center grayscale lg:max-h-none"
        loading="lazy"
      />
    </div>
  </div>
</section>
