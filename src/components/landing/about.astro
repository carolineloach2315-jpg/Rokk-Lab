---
const highlights = [
  {
    title: "Cut",
    image: "/images/service-cut.png",
    description: "Precision cuts tailored to your style.",
  },
  {
    title: "Color",
    image: "/images/service-colour.png",
    description: "Modern color techniques that enhance you.",
  },
  {
    title: "Styling",
    image: "/images/service-style.png",
    description: "Blowouts, waves, and finishing touches.",
  },
  {
    title: "Treatments",
    image: "/images/service-treatment.png",
    description: "Nourishing treatments for healthy hair.",
  },
];
---

<section id="about" class="bg-[#191919] text-white">
  <div class="grid lg:grid-cols-[0.9fr_0.9fr_1.55fr]">
    <div class="relative min-h-72 overflow-hidden lg:min-h-[20rem]">
      <img
        src="/images/salon.png"
        alt="Rokk Lab salon interior"
        class="absolute inset-0 h-full w-full object-cover grayscale"
      />
    </div>

    <div class="flex items-start px-6 py-8 md:px-12 lg:px-10 lg:pt-8">
      <div>
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.35em] text-orange-600">
          About us
        </p>

        <h2 class="mb-5 text-2xl font-black uppercase leading-tight sm:text-3xl md:text-2xl">
          Experts in beauty and precision.
        </h2>

        <p class="max-w-md text-sm font-semibold leading-6 text-neutral-300">
          At Rokk Lab, we blend creativity with technique to create hair that
          looks effortless, modern, and tailored to you.
        </p>

        <a
          href="/about"
          class="mt-6 inline-flex items-center justify-center border border-white bg-[#191919] px-8 py-4 text-xs font-bold uppercase tracking-wide text-white transition hover:bg-white hover:text-black"
        >
          Learn More
        </a>
      </div>
    </div>

    <div class="flex items-center px-6 pb-10 md:px-16 lg:py-7 lg:pl-16 lg:pr-4 xl:pl-20 xl:pr-8">
      <div class="grid w-full grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4 xl:gap-x-8">
        {
          highlights.map((item, index) => (
            <div
              class={`service-card flex min-w-0 flex-col items-center px-3 text-center xl:px-4 ${
                index === 0 ? "" : "xl:border-l xl:border-white/20"
              } ${index % 2 === 1 ? "lg:border-l lg:border-white/20 xl:border-l" : ""}`}
              style={`--icon-delay: ${index * 0.18}s`}
            >
              <img
                src={item.image}
                alt=""
                class="service-icon mb-5 h-16 w-16 object-contain"
              />

              <p class="text-sm font-black uppercase tracking-wide text-white">
                {item.title}
              </p>

              <p class="mt-3 max-w-[9.5rem] text-[11px] font-medium leading-5 text-neutral-300">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
