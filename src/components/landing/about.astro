---
import ServiceIcon from "./service-icon.astro";

const highlights = [
  {
    title: "Cut",
    icon: "cut",
    description: "Precision cuts tailored to your style.",
  },
  {
    title: "Colour",
    icon: "colour",
    description: "Modern colour techniques that enhance you.",
  },
  {
    title: "Styling",
    icon: "styling",
    description: "Blowouts, waves, and finishing touches.",
  },
  {
    title: "Treatments",
    icon: "treatments",
    description: "Nourishing treatments for healthy hair.",
  },
] as const;
---

<section id="about" class="bg-[#171717] px-6 py-14 text-white md:px-16 md:py-16">
  <div class="mx-auto max-w-7xl">
    <div
      class="grid grid-cols-2 gap-y-10 md:grid-cols-4"
      data-stagger-parent
      data-micro-reveal-group
    >
      {
        highlights.map((item, index) => (
          <article
            class={`flex min-w-0 flex-col items-center px-4 text-center md:px-8 ${
              index === 0 ? "" : "md:border-l md:border-white/25"
            }`}
            data-stagger-card
            data-micro-card
            data-micro-reveal-item
          >
            <div class="mb-6 h-16 w-16 text-white md:h-20 md:w-20">
              <ServiceIcon name={item.icon} />
            </div>

            <h2 class="text-base font-black uppercase tracking-wide text-white md:text-lg">
              {item.title}
            </h2>

            <p class="mt-4 max-w-44 text-sm font-semibold leading-6 text-white md:text-base md:leading-7">
              {item.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
